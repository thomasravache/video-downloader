{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "entrypoints",
    "tests",
    "e2e",
    "wxt.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    ".wxt/wxt.d.ts"
  ]
}
