{
  "name": "video-downloader",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.11.0",
    "m3u8-parser": "7.2.0",
    "mux.js": "6.3.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  },
  "scripts": {
    "postinstall": "FLAVOR=public wxt prepare",
    "dev": "FLAVOR=local wxt --mode flavor-local",
    "build": "pnpm build:public && pnpm build:local",
    "build:public": "FLAVOR=public wxt build --mode public",
    "build:local": "FLAVOR=local wxt build --mode flavor-local",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "FLAVOR=public wxt prepare && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "test:e2e": "node e2e/support/run.ts",
    "arch": "depcruise src entrypoints --config .dependency-cruiser.cjs",
    "coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24"
  }
}
